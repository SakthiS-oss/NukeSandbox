# Local development only. Use External Secrets Operator (k8s/external-secret.yaml) in Kubernetes.
GOOGLE_API_KEY=replace-with-local-development-key
NUKESANDBOX_MODEL=gemini-2.5-flash
LOG_LEVEL=INFO

# Production controls: enable only with a reachable Redis instance.
RATE_LIMIT_ENABLED=false
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60
CONCURRENCY_LIMIT_ENABLED=false
MAX_CONCURRENT_SANDBOXES=5
SANDBOX_SLOT_TTL_SECONDS=30

# Set API_AUTH_REQUIRED=true before exposing the API. API_KEY_HASHES stores a
# JSON map of identity to SHA-256 API-key digest, e.g. {"alice":"<digest>"}.
API_AUTH_REQUIRED=false
# API_KEY_HASHES={}

# Production Kubernetes mode forces sandbox network traffic through this proxy.
# SANDBOX_EGRESS_PROXY=http://nukesandbox-egress-proxy:3128
# REQUIRE_EGRESS_PROXY=true

# Azure Container Apps Job runner. Terraform sets these on the API Container App.
# SANDBOX_EXECUTION_MODE=azure
# AZURE_CLIENT_ID=
# AZURE_SUBSCRIPTION_ID=
# AZURE_RESOURCE_GROUP=rg-nukesandbox
# AZURE_SANDBOX_JOB_NAME=nukesandbox-sandbox
# AZURE_CONTAINER_APP_ENVIRONMENT_ID=

# Set this to an OpenTelemetry Collector gRPC endpoint to export traces.
# OTEL_EXPORTER_OTLP_ENDPOINT=otel-collector:4317
