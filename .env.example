# Local development only. Use External Secrets Operator (k8s/external-secret.yaml) in Kubernetes.
GOOGLE_API_KEY=replace-with-local-development-key
NUKESANDBOX_MODEL=gemini-2.5-flash
LOG_LEVEL=INFO

# Production controls: enable only with a reachable Redis instance.
RATE_LIMIT_ENABLED=false
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60

# Set this to an OpenTelemetry Collector gRPC endpoint to export traces.
# OTEL_EXPORTER_OTLP_ENDPOINT=otel-collector:4317
